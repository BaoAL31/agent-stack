      "name": "Ollama",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    },
    "inferx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "InferX",
      "options": {
        "baseURL": "https://model.inferx.net/endpoints/v1",
        "apiKey": "ix_6d0f2558c8f90c7913d4cb8431bed41e7e4a185e1c50fbe5f52f090e52b98597"
      },
      "models": {
        "deepseek-v4-flash-0731": {
          "name": "DeepSeek-V4-Flash-0731",
          "limit": {
            "context": 1048576,
            "output": 262144
          },
          "reasoning": true
        }
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "ENV_OPENROUTER_API_KEY"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek-V4-Pro",
