{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/plugin/shell-strategy/shell_strategy.md"
  ],
  "skills": {
    "paths": [
      "~/.agents/skills"
    ]
  },
  "model": "opencode/deepseek-v4-flash-free",
