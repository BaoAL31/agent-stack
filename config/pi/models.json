// pi-nvidia-nim extension handles all NVIDIA NIM models.
// Loaded as a git package: ~/.pi/agent/git/github.com/xRyul/pi-nvidia-nim
// (deepseek-r1/v3/v4, GLM-5.3, Kimi, Qwen, Llama and 70+ more are served
//  by that extension under provider "nvidia-nim" — no models.json block needed.)
{
  "providers": {
    "openrouter": {
      "models": [
        {
          "id": "tencent/hy3:free",
          "name": "Tencent HY3 (Free)",
          "contextWindow": 262144,
          "maxTokens": 8192
        },
        {
          "id": "stealth/ox-alpha",
          "name": "Stealth Ox Alpha (OpenRouter)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 1048576,
          "maxTokens": 131072,
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": "low",
            "medium": "high",
            "high": "high",
            "xhigh": "max",
            "max": "max"
          }
        }
      ]
    }
  }
}
